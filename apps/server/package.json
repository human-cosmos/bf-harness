{
  "name": "@bugfix-harness/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "accept:e2e": "tsx scripts/e2e-acceptance.ts",
    "accept:unit": "vitest run test/acceptance.test.ts",
    "accept:crash": "tsx scripts/crash-recovery-smoke.ts"
  },
  "dependencies": {
    "@bugfix-harness/shared": "workspace:*",
    "@fastify/websocket": "^11.2.0",
    "fastify": "^5.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
